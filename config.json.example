{
    "_note": "Copy this to config.json and fill in api_id/api_hash from https://my.telegram.org",

    "tdjson_path": "~/td/tdlib/lib/libtdjson.so",
    "api_id": 12345678,
    "api_hash": "your_api_hash_here",
    "debug": false,

    "llm": {
        "default_provider": "codex",
        "continue_keyword": "cont",
        "bridge_dir": ".llm_bridge",
        "poll_interval_seconds": 1.0,
        "output_stable_seconds": 1.0,

        "translation": {
            "provider": "codex",
            "timeout_seconds": 120,
            "command": "codex exec -C {root} --sandbox read-only --ask-for-approval never -o {output} -"
        },

        "providers": {
            "codex": {
                "session_name": "tgself-codex",
                "command": "codex --no-alt-screen --search -C {root} --dangerously-bypass-approvals-and-sandbox",
                "continue_command": "codex resume --last --no-alt-screen --search -C {root} --dangerously-bypass-approvals-and-sandbox",
                "prompt_delivery": "argv",
                "timeout_seconds": 900,
                "startup_delay_seconds": 3.0,
                "reset_strategy": "recreate"
            },
            "claude": {
                "session_name": "tgself-claude",
                "command": "claude --dangerously-skip-permissions",
                "continue_command": "claude --continue --dangerously-skip-permissions",
                "prompt_delivery": "argv",
                "timeout_seconds": 900,
                "startup_delay_seconds": 3.0,
                "reset_strategy": "recreate"
            },
            "grok": {
                "session_name": "tgself-grok",
                "command": "grok --no-alt-screen --cwd {root} --always-approve --permission-mode bypassPermissions",
                "prompt_delivery": "paste",
                "submit_keys": ["Enter"],
                "timeout_seconds": 900,
                "startup_delay_seconds": 3.0,
                "reset_strategy": "recreate"
            }
        }
    },

    "rules": [
        {"match": "exact",  "keyword": "테스트", "action": "reply", "text": "test done"},

        {"match": "suffix", "keyword": "to en", "action": "translate", "lang": "English"},
        {"match": "suffix", "keyword": "to jp", "action": "translate", "lang": "Japanese"},
        {"match": "suffix", "keyword": "to cn", "action": "translate", "lang": "Chinese (Simplified)"},
        {"match": "suffix", "keyword": "to kr", "action": "translate", "lang": "Korean"},

        {"match": "suffix", "keyword": "to ai",     "action": "ask_llm", "provider": "codex"},
        {"match": "suffix", "keyword": "to codex",  "action": "ask_llm", "provider": "codex"},
        {"match": "suffix", "keyword": "to claude", "action": "ask_llm", "provider": "claude"},
        {"match": "suffix", "keyword": "to grok",   "action": "ask_llm", "provider": "grok"},

        {"match": "prefix", "keyword": "ai provider to ", "action": "set_provider"}
    ]
}
